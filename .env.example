# kflood の設定（.env にコピーして使う。リポジトリには .env を入れない）
# PostGIS のデータ実体。全国分は数十GBになるので別ディスクを推奨（既定は ./data/pg）
KFLOOD_PG_DIR=./data/pg
# 配布 zip の置き場（既定は ./data/raw）
KFLOOD_RAW_DIR=./data/raw
# DB の待ち受けポートとパスワード。外部公開時はパスワードを必ず変える
KFLOOD_DB_PORT=55434
KFLOOD_DB_PASS=kflood_local
# アプリの待ち受けポート
KFLOOD_PORT=18386
# 画面に出す名前（自治体名や事務所名に変えてよい）
KFLOOD_SITE_NAME=Kurage 洪水・内水ハザードマップ
